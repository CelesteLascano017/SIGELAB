# Copy to .env.local and fill with the credentials of the NEW SIGELAB Supabase project.
# NEVER reuse credentials from any other Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://<new-sigelab-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server-only. Used ONLY by scripts/seed-demo.ts. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Safety check: the project ref of the NEW SIGELAB project (the subdomain of the URL above).
SIGELAB_EXPECTED_PROJECT_REF=<new-sigelab-project-ref>

# Password for demo accounts created by seed:demo (choose your own; never commit)
DEMO_PASSWORD=<choose-a-strong-password>
